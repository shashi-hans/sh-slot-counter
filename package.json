{
  "name": "sh-slot-counter",
  "version": "1.1.0",
  "description": "Lightweight, dependency-free slot-machine number counter for React — with the baseline-alignment, infinite-spin, and reset issues fixed.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "vite",
    "demo:build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "slot",
    "counter",
    "slot-counter",
    "odometer",
    "number",
    "animation",
    "rolling",
    "count-up"
  ],
  "author": "Shashi Hans <shashi.hans@coverstack.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashi-hans/sh-slot-counter.git"
  },
  "homepage": "https://github.com/shashi-hans/sh-slot-counter#readme",
  "bugs": {
    "url": "https://github.com/shashi-hans/sh-slot-counter/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
